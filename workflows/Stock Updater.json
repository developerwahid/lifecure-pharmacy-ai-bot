{
  "name": "Stock Updater",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const orders = $('Google Sheets Trigger1').all().map(i => i.json);\nconst meds = $input.all().map(i => i.json);\n\nconst LOW = 5; // is se kam bacha to low stock alert\nconst stock = {};\nmeds.forEach(m => {\n  stock[String(m['Medicine Name']).trim().toLowerCase()] = { name: m['Medicine Name'], qty: Number(m['Quantity']) };\n});\n\nconst out = [];\nconst touched = new Set();\n\norders.forEach(order => {\n  const names = String(order['Medicine Name']).split(',').map(s => s.trim()).filter(Boolean);\n  const qtys = String(order['Quantity']).split(',').map(s => Number(s.trim()));\n\n  names.forEach((name, i) => {\n    const qty = qtys[i] || 0;\n    const med = stock[name.toLowerCase()];\n    if (!med) {\n      out.push({ json: { update: false, alert: `⚠️ Order #${order['Order ID']}: \"${name}\" sheet mein nahi mili. Stock update nahi hua.` } });\n      return;\n    }\n    if (qty > med.qty) {\n      out.push({ json: { update: false, alert: `❌ Order #${order['Order ID']}: ${med.name} ka stock kam tha (stock ${med.qty}, order ${qty}). Stock 0 kar diya, check karo.` } });\n    }\n    med.qty = Math.max(med.qty - qty, 0);\n    touched.add(name.toLowerCase());\n  });\n});\n\ntouched.forEach(key => {\n  const med = stock[key];\n  let alert = '';\n  if (med.qty === 0) alert = `🚫 ${med.name} Out of Stock ho gayi.`;\n  else if (med.qty < LOW) alert = `⚠️ Low stock: ${med.name} sirf ${med.qty} bacha hai.`;\n  out.push({ json: { update: true, medicine: med.name, newQty: med.qty, alert } });\n});\n\nreturn out;"
      },
