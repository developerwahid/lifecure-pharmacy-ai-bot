    {
      "parameters": {
        "jsCode": "const orders = [$('If Is Cancelled?').first().json];\nconst meds = $('Get row(s) Get Medicines').all().map(i => i.json);\n\nconst add = {};\nfor (const o of orders) {\n  const names = String(o['Medicine Name'] || '').split(',').map(s => s.trim()).filter(Boolean);\n  const qtys = String(o['Quantity'] || '').split(',').map(s => Number(s.trim()));\n  names.forEach((n, i) => {\n    const m = meds.find(x => String(x['Medicine Name']).trim().toLowerCase() === n.toLowerCase());\n    const q = qtys[i];\n    if (!m || isNaN(q)) return;\n    const key = m['Medicine Name'];\n    add[key] = (add[key] || 0) + q;\n  });\n}\n\nconst out = [];\nfor (const name of Object.keys(add)) {\n  const m = meds.find(x => x['Medicine Name'] === name);\n  out.push({ json: {\n    medicine: name,\n    restored: add[name],\n    newQty: Number(m['Quantity']) + add[name],\n    orderId: orders[0]['Order ID']\n  }});\n}\nreturn out;"
      },
