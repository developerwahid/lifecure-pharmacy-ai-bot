        "message": "=<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"UTF-8\">\n<style> \n  .tbl { width:100%; border-collapse:collapse; }\n  .tbl th { background:#f1f5f4; color:#375a52; font-size:12px; text-transform:uppercase; letter-spacing:0.5px; text-align:left; padding:10px 12px; border-bottom:2px solid #d5e3df; }\n  .tbl td { font-size:14px; color:#222222; padding:10px 12px; border-bottom:1px solid #eeeeee; }\n</style>\n<title>Order Cancelled</title>\n</head>\n<body>\n<div style=\"background:#f4f6f5;padding:24px 0;font-family:Arial,Helvetica,sans-serif;\">\n<table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" align=\"center\" style=\"max-width:600px;width:100%;background:#ffffff;border-radius:10px;overflow:hidden;border:1px solid #e3e8e6;\">\n  <tr>\n    <td style=\"background:#0f766e;padding:24px 28px;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n        <tr>\n          <td align=\"left\" style=\"width:100px;vertical-align:middle;padding-right:18px;\">\n            <img src=\"https://lh3.googleusercontent.com/d/1Ng2gDalChx-yp34ZF_TYVMFZpam98GEM\" alt=\"Life Cure Pharmacy Logo\" style=\"width:100px;height:100px;display:block;background:#ffffff;border-radius:20%;border:none;\">\n          </td>\n          <td align=\"left\" style=\"vertical-align:middle;\">\n            <div style=\"color:#ffffff;font-size:24px;font-weight:bold;line-height:1.2;\">Life Cure Pharmacy</div>\n            <div style=\"color:#fecaca;font-size:14px;margin-top:6px;\"> 🛑 Order Cancelled</div>\n          </td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:22px 28px 8px 28px;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr>\n          <td style=\"font-size:13px;color:#222222;\">{{ (() => { const h = Number($now.setZone('Asia/Kolkata').toFormat('H')); return h >= 5 && h < 12 ? '☀️ Good Morning' : h >= 12 && h < 17 ? '🌤️ Good Afternoon' : h >= 17 && h < 21 ? '🌆 Good Evening' : 'Hello'; })() }} : <b>{{ $('If Is Cancelled?').first().json['Customer Name'] }}</b>,</td>\n          <td align=\"right\" style=\"font-size:13px;color:#777777;\">Date &amp; Time<br><span style=\"font-size:14px;color:#222222;font-weight:bold;\">{{ $now.setZone('Asia/Kolkata').toFormat('dd-MM-yyyy hh:mm a') }}</span></td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:14px 28px 6px 28px;font-size:15px;color:#222222;\">\n      Aapka order :<b> #{{ $('If Is Cancelled?').first().json['Order ID'] }}</b> <span style=\"color:#b91c1c;font-weight:bold;\">Cancel Kar Diya Gaya Hai. 😔</span>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:6px 28px 8px 28px;\">\n      <div style=\"font-size:12px;color:#375a52;text-transform:uppercase;letter-spacing:0.5px;font-weight:bold;margin-bottom:8px;\">Cancelled Medicines</div>\n      <table class=\"tbl\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\">\n        <tr><th>Medicine</th><th>Qty</th><th>Price</th><th>Subtotal</th></tr>\n        {{ (() => { const o = $('If Is Cancelled?').first().json; const n = String(o['Medicine Name']).split(',').map(s => s.trim()); const q = String(o['Quantity']).split(',').map(s => s.trim()); const p = String(o['Price Per Unit']).split(',').map(s => s.trim()); return n.map((x, i) => '<tr><td>' + x + '</td><td>' + q[i] + '</td><td>₹' + p[i] + '</td><td>₹' + (Number(q[i]) * Number(p[i])) + '</td></tr>').join(''); })() }}\n      </table>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:6px 28px 16px 28px;\">\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#0f766e;border-radius:8px;\">\n        <tr>\n          <td style=\"padding:14px 16px;font-size:14px;color:#c7ebe6;\">Order Total</td>\n          <td align=\"right\" style=\"padding:14px 16px;font-size:22px;color:#ffffff;font-weight:bold;\">₹{{ $('If Is Cancelled?').first().json['Total Price'] }}</td>\n        </tr>\n      </table>\n    </td>\n  </tr>\n  <tr>\n    <td style=\"padding:0 28px 18px 28px;font-size:14px;color:#222222;\">\n      Naya Order Karna Chahte Hain, To Life Cure Pharmacy bot par message Karein — Hum Aapki Poori Madad Karenge. 🤝\n    </td>\n  </tr>\n \n   <tr>\n    <td style=\"padding:14px 28px;\">\n      <div style=\"font-size:12px;color:#375a52;text-transform:uppercase;letter-spacing:0.5px;font-weight:bold;margin-bottom:8px;\">Customer Details</div>\n      <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f8faf9;border:1px solid #929694;border-radius:8px;\">\n       <tr><td style=\"padding:12px 14px;font-size:13px;color:#000000;\">Contact:</td><td style=\"padding:12px 14px;font-size:12px;color:#222222;font-weight:bold;\"> {{ $('If Is Cancelled?').first().json['Contact Number'] }}</td></tr>\n        <tr><td style=\"padding:12px 14px;font-size:13px;color:#000000;vertical-align:top;\">Delivery Address:</td><td style=\"padding:12px 14px;font-size:12px;color:#222222;font-weight:bold;\"> {{ $('If Is Cancelled?').first().json['Customer Address'] }}</td></tr>\n      </table>\n    </td>\n  </tr>\n\n  <tr>\n    <td style=\"background:#f8faf9;padding:16px 28px;border-top:1px solid #e3e8e6;font-size:12px;color:#888888;text-align:center;\">\n      Koi madad chahiye to call karein: YOUR_SHOP_PHONE <br> <span style=\"color: #0f766e;\">Life Cure Pharmacy </span> aapko achhi sehat ki shubhkamnayein ❤️\n    </td>\n  </tr>\n</table>\n</div>\n</body>\n</html>",
